// Prototype rules for private users/{uid}/notes/{uuid} and categories/{uuid}.
// Notes: uid (immutable, 1..128), title (0..200), content (1..100000),
// category (1..60), revision (36), archived/deleted (bool), updatedAt (epoch ms),
// reminderAt (nullable epoch ms), syncedAt (server timestamp).
// Categories: uid, name (1..60), revision (36), syncedAt (server timestamp).
// Parent users documents are intentionally absent; ownership comes from Auth.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function uidUnchanged() { return request.resource.data.uid == request.auth.uid; }
    function uidNotModified() { return request.resource.data.uid == resource.data.uid; }
    function validString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function validMillis(value) { return value is int && value >= 0 && value <= 253402300799999; }
    function validBase(d) {
      return validString(d.uid, 1, 128) && validString(d.revision, 36, 36)
        && d.syncedAt is timestamp && d.syncedAt == request.time;
    }
    function isValidNote(d) {
      let keys = ['uid', 'title', 'content', 'category', 'revision', 'archived', 'deleted', 'updatedAt', 'reminderAt', 'syncedAt'];
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys) && validBase(d)
        && validString(d.title, 0, 200) && validString(d.content, 1, 100000)
        && validString(d.category, 1, 60) && d.archived is bool && d.deleted is bool
        && validMillis(d.updatedAt) && (d.reminderAt == null || validMillis(d.reminderAt));
    }
    function isValidCategory(d) {
      let keys = ['uid', 'name', 'revision', 'syncedAt'];
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys) && validBase(d) && validString(d.name, 1, 60);
    }
    match /users/{uid}/notes/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && id.size() == 36 && uidUnchanged() && isValidNote(request.resource.data);
      allow update: if isOwner(uid) && uidUnchanged() && uidNotModified()
        && (!resource.data.deleted || request.resource.data.deleted) && isValidNote(request.resource.data);
      // Deletion is a synchronized tombstone; clients must not erase history.
      allow delete: if false;
    }
    match /users/{uid}/categories/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && id.size() == 36 && uidUnchanged() && isValidCategory(request.resource.data);
      allow update: if isOwner(uid) && uidUnchanged() && uidNotModified() && isValidCategory(request.resource.data);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
